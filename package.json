{
  "name": "fate-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply fate-collector --local",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy": "node scripts/deploy.mjs",
    "release:pack": "node scripts/release.mjs pack",
    "release:verify": "node scripts/release.mjs verify",
    "test:staging": "node scripts/smoke-staging.mjs",
    "test:helper": "node scripts/test-helper.mjs capture",
    "test:upload": "node scripts/test-helper.mjs upload",
    "test:upload:integration": "node scripts/test-cloud-upload.mjs",
    "predev": "node scripts/stage-helper.mjs",
    "prebuild": "node scripts/stage-helper.mjs",
    "test:diagnostics": "node scripts/test-helper.mjs diagnostics"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "fflate": "0.8.3",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
