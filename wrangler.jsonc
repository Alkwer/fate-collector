{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-07",
  "vars": { "APP_ENV": "local", "RELEASE_REVISION": "local", "RELEASE_ID": "local" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fate-collector",
    // Local development only. Configure a real database ID before deployment.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "DIAGNOSTIC_RATE_LIMITER", "namespace_id": "2026110801", "simple": { "limit": 20, "period": 60 } },
    { "name": "CONSENT_WITHDRAWAL_RATE_LIMITER", "namespace_id": "2026111101", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["*/15 * * * *"] }
}
